{
  "name": "cursed-era-online",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "electron .",
    "build": "electron-builder"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.cursedera.game",
    "productName": "Cursed Era",
    "directories": {
      "output": "dist"
    },
    "win": {	
      "target": "nsis"
    },
    "files": [
      "main.js",
      "server.js",
      "index.html",
      "package.json",
      "**/*"
    ]
  }
}